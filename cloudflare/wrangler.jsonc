{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "traider-cloudflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "TRADING_ACCOUNT", "class_name": "TradingAccount" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TradingAccount"] }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"]
  },
  "vars": { "DEMO_MODE": "true" }
}
