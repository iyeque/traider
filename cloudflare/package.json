{
  "name": "traider-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Traider demo trading accounts on Cloudflare Agents / Durable Objects (free tier). TypeScript port of the Python bot's strategy core.",
  "scripts": {
    "dev:worker": "wrangler dev",
    "dev:dashboard": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "agents": "^0.34.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.40.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261119.1": true,
    "core-js-pure": false
  }
}